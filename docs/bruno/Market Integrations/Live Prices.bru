meta {
  name: Live Prices
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/market-integrations/live-prices
  body: none
  auth: bearer
}

params:query {
  source: viwanda
  commodity: 
  market: 
  page: 1
  page_size: 10
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Shows normalized records directly from the configured source/cache before DB import.

  Path params:
  - None

  Query params:
  - source: optional source key. Use viwanda for the Viwanda scraper cache.
  - commodity: optional commodity name/symbol filter.
  - market: optional exact market name filter.
  - page: page number.
  - page_size: records per page, capped by API.

  Auth:
  - Bearer token with market integration permission.

  Notes:
  - This does not write to the database.
  - For Viwanda, records come from src/apps/market_integrations/scrapper/data/prices.json.
}
