meta {
  name: Health Check
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/market-integrations/health
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Checks health/reachability of active market integration sources.
  
  Path params:
  - None
  
  Query params:
  - None
  
  Auth:
  - Bearer token with market integration permission.
  
  Notes:
  - API sources are checked by requesting their health path.
  - The internal source is read from local DB data.
  - Viwanda currently reads the local scraper cache instead of downloading PDFs.
}
