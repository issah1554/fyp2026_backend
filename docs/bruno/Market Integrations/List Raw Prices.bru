meta {
  name: List Raw Prices
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/v1/market-integrations/raw-prices
  body: none
  auth: bearer
}

params:query {
  source: viwanda
  commodity: 
  market: 
  search: 
  ordering: -observed_at
  page: 1
  page_size: 10
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Lists imported raw source records from raw_commodity_prices.

  Path params:
  - None

  Query params:
  - source: optional source key. Use viwanda to show Viwanda raw records.
  - commodity: optional commodity filter.
  - market: optional exact market filter.
  - search: optional search across source, source reference, market, commodity, price type, currency, normalized price id.
  - ordering: optional sort. Supported fields include source, commodity, market, price, reference, observed_at, normalized_price_id. Prefix with - for descending.
  - page: page number.
  - page_size: records per page, capped by API.

  Auth:
  - Bearer token with market integration permission.

  Notes:
  - Raw rows preserve source payload/reference.
  - normalized_price_id links a raw row to its standardized commodities_prices row when standardization has happened.
}
