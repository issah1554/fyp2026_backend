meta {
  name: Verify Email
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/auth/email/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{user_email}}",
    "code": "{{email_verification_code}}"
  }
}

vars:pre-request {
  email_verification_code: 123456
}
