meta {
  name: Password Reset Confirm
  type: http
  seq: 9
}

post {
  url: {{base_url}}/api/v1/auth/password/reset/confirm
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{password_reset_token}}",
    "password": "{{new_user_password}}"
  }
}
