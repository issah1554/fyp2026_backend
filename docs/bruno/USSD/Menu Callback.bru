meta {
  name: Menu Callback
  type: http
  seq: 1
}

post {
  url: {{base_url}}/ussd/menu
  body: text
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:text {
  we
}

body:form-urlencoded {
  sessionId: {{ussd_session_id}}
  serviceCode: {{ussd_service_code}}
  phoneNumber: {{ussd_phone_number}}
  text: {{ussd_text}}
}
