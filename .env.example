SECRET_KEY=change-this-secret-key
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost,unable-periscope-boil.ngrok-free.dev
CORS_ALLOWED_ORIGINS=https://unable-periscope-boil.ngrok-free.dev
CSRF_TRUSTED_ORIGINS=https://unable-periscope-boil.ngrok-free.dev

DB_ENGINE=django.db.backends.postgresql
DB_NAME=fyp2026_backend
DB_USER=postgres
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=Smart Market <onboarding@your-verified-domain.com>
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=your-resend-api-key
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true

MARKET_INTEGRATION_TIMEOUT_SECONDS=8
PLATFORM_A_BASE_URL=http://localhost:3001
PLATFORM_B_BASE_URL=http://localhost:3002
VIWANDA_BASE_URL=https://www.viwanda.go.tz

# USSD live market price API / simulator
USSD_MARKET_PRICE_API_BASE_URL=https://ditapi.databenki.co.tz/api/v1
USSD_MARKET_PRICE_API_TIMEOUT_SECONDS=10
USSD_SIMULATOR_API_BASE_URL=http://localhost:8000/api/v1

# External weather source used by USSD weather forecast
USSD_WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
USSD_WEATHER_API_TIMEOUT_SECONDS=10
